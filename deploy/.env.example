# Copy to deploy/.env (git-ignored) to configure docker compose.

# Host address the game (UDP 7777) and TLS login (TCP 7779) ports bind to.
# Default 0.0.0.0 (all interfaces). Set 127.0.0.1 or one LAN address to restrict access.
EMBERFALL_GAME_BIND=0.0.0.0

# EMBERFALL_LOG_LEVEL=info
# EMBERFALL_MAX_PLAYERS=200
# EMBERFALL_ADMIN_PASSWORD=
