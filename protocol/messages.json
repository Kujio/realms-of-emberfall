      {"name": "entity_id", "type": "u32"},
      {"name": "zone_id", "type": "string", "max": 32},
      {"name": "zone_name", "type": "string", "max": 64},
      {"name": "min_x", "type": "f32"},
      {"name": "min_z", "type": "f32"},
      {"name": "max_x", "type": "f32"},
      {"name": "max_z", "type": "f32"},
      {"name": "x", "type": "f32"},
      {"name": "y", "type": "f32"},
      {"name": "z", "type": "f32"},
      {"name": "yaw", "type": "f32"},
      {"name": "run_speed", "type": "f32"},
      {"name": "tick_rate", "type": "u8"},
      {"name": "server_tick", "type": "u32"},
      {"name": "zone_kind", "type": "string", "max": 16, "_comment": "hub, outdoor, dungeon, test"},
      {"name": "seed", "type": "u32", "_comment": "dungeons: the layout seed (the client builds the same rooms)"},
      {"name": "layout_hash", "type": "u32", "_comment": "the client checks its bundled zone data against this"},
      {"name": "zone_change", "type": "bool", "_comment": "true when moving between zones (the session stays in the world)"},
      {"name": "level_min", "type": "u8"},
      {"name": "level_max", "type": "u8"}
    ]},
    {"id": 29, "name": "Logout", "dir": "c2s", "channel": 0, "fields": []},
    {"id": 30, "name": "LogoutResult", "dir": "s2c", "channel": 0, "fields": [
      {"name": "ok", "type": "bool"}
    ]},
