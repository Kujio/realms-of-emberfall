{
  "_comment": "Realms of Emberfall wire protocol. Edit this file, then run `python tools/gen_protocol.py` to regenerate C++ and GDScript. Bump `version` on any breaking change.",
  "version": 5,
  "encoding": "Little-endian. Packet = u16 message id + fields in order. string = u16 byte length + UTF-8 (max enforced). array = u16 count + elements (max enforced). f32 must be finite. Trailing bytes are rejected.",
  "channels": {
    "0": "reliable ordered: handshake, auth, characters, spawns, chat, combat events, loot",
    "1": "unreliable sequenced: movement input, snapshots, player stats",
    "2": "TLS login stream (TCP, never ENet): u16 length prefix + packet; carries the password"
  },
  "structs": {
    "CharSummary": [
      {"name": "id", "type": "u64"},
      {"name": "name", "type": "string", "max": 15},
      {"name": "race", "type": "string", "max": 32},
      {"name": "class_id", "type": "string", "max": 32},
      {"name": "city", "type": "string", "max": 32},
      {"name": "level", "type": "u8"},
      {"name": "zone", "type": "string", "max": 32},
      {"name": "gender", "type": "u8", "_comment": "0 = female, 1 = male"}
    ],
    "OptionEntry": [
      {"name": "id", "type": "string", "max": 32},
      {"name": "name", "type": "string", "max": 48},
      {"name": "description", "type": "string", "max": 256}
    ],
    "RaceOption": [
      {"name": "id", "type": "string", "max": 32},
      {"name": "name", "type": "string", "max": 48},
      {"name": "description", "type": "string", "max": 256},
      {"name": "classes", "type": "array", "of": "string", "max": 32, "max_len": 32},
      {"name": "cities", "type": "array", "of": "string", "max": 8, "max_len": 32}
    ],
    "EntityState": [
      {"name": "entity_id", "type": "u32"},
      {"name": "x", "type": "f32"},
      {"name": "y", "type": "f32"},
      {"name": "z", "type": "f32"},
      {"name": "yaw", "type": "f32"},
      {"name": "hp_pct", "type": "u8"},
      {"name": "flags", "type": "u8"}
    ],
    "AbilityInfo": [
      {"name": "id", "type": "string", "max": 32},
      {"name": "name", "type": "string", "max": 48},
      {"name": "type", "type": "string", "max": 16},
      {"name": "level", "type": "u8"},
      {"name": "resource", "type": "u8"},
      {"name": "cost", "type": "u16"},
      {"name": "cooldown_ms", "type": "u32"},
      {"name": "range", "type": "f32"},
      {"name": "target", "type": "u8"},
      {"name": "gcd", "type": "bool"},
      {"name": "description", "type": "string", "max": 256}
    ],
    "ItemStack": [
      {"name": "slot", "type": "u8"},
      {"name": "item_id", "type": "string", "max": 32},
      {"name": "name", "type": "string", "max": 48},
      {"name": "count", "type": "u16"},
      {"name": "kind", "type": "string", "max": 16}
    ],
    "SkillValue": [
      {"name": "id", "type": "string", "max": 32},
      {"name": "name", "type": "string", "max": 48},
      {"name": "value", "type": "u16"},
      {"name": "cap", "type": "u16"}
    ],
    "SpellInfo": [
      {"name": "id", "type": "string", "max": 32},
      {"name": "name", "type": "string", "max": 48},
      {"name": "type", "type": "string", "max": 16},
      {"name": "level", "type": "u8"},
      {"name": "mana", "type": "u16"},
      {"name": "cast_ms", "type": "u32"},
      {"name": "recast_ms", "type": "u32"},
      {"name": "duration_ms", "type": "u32"},
      {"name": "range", "type": "f32"},
      {"name": "target", "type": "u8"},
      {"name": "resist", "type": "u8"},
      {"name": "description", "type": "string", "max": 256}
    ],
    "GemSlot": [
      {"name": "spell_id", "type": "string", "max": 32},
      {"name": "ready_ms", "type": "u32"}
    ],
    "BuffInfo": [
      {"name": "spell_id", "type": "string", "max": 32},
      {"name": "name", "type": "string", "max": 48},
      {"name": "remaining_ms", "type": "u32"},
      {"name": "beneficial", "type": "bool"},
      {"name": "caster", "type": "string", "max": 32},
      {"name": "school", "type": "u8"}
    ],
    "TrainerEntry": [
      {"name": "item_id", "type": "string", "max": 32},
      {"name": "spell_id", "type": "string", "max": 32},
      {"name": "name", "type": "string", "max": 48},
      {"name": "level", "type": "u8"},
      {"name": "price", "type": "u32"},
      {"name": "known", "type": "bool"}
    ]
  },
  "messages": [
    {"id": 1, "name": "Hello", "dir": "c2s", "channel": 0, "fields": [
      {"name": "protocol_version", "type": "u16"},
      {"name": "client_build", "type": "string", "max": 64}
    ]},
    {"id": 2, "name": "HelloResult", "dir": "s2c", "channel": 0, "fields": [
      {"name": "ok", "type": "bool"},
      {"name": "server_protocol_version", "type": "u16"},
      {"name": "message", "type": "string", "max": 256},
      {"name": "login_port", "type": "u16"},
      {"name": "cert_pem", "type": "string", "max": 3000},
      {"name": "session_nonce", "type": "string", "max": 64}
    ]},
    {"id": 3, "name": "Kick", "dir": "s2c", "channel": 0, "fields": [
      {"name": "reason", "type": "string", "max": 256}
    ]},

    {"id": 10, "name": "TlsLogin", "dir": "c2s", "channel": 2, "fields": [
      {"name": "username", "type": "string", "max": 32},
      {"name": "password", "type": "string", "max": 128},
      {"name": "is_register", "type": "bool"},
      {"name": "session_nonce", "type": "string", "max": 64}
    ]},
    {"id": 11, "name": "TlsLoginResult", "dir": "s2c", "channel": 2, "fields": [
      {"name": "ok", "type": "bool"},
      {"name": "message", "type": "string", "max": 256},
      {"name": "ticket", "type": "string", "max": 64}
    ]},
    {"id": 13, "name": "TicketLogin", "dir": "c2s", "channel": 0, "fields": [
      {"name": "ticket", "type": "string", "max": 64}
    ]},
    {"id": 12, "name": "AuthResult", "dir": "s2c", "channel": 0, "fields": [
      {"name": "ok", "type": "bool"},
      {"name": "message", "type": "string", "max": 256}
    ]},

    {"id": 20, "name": "CharListRequest", "dir": "c2s", "channel": 0, "fields": []},
    {"id": 21, "name": "CharList", "dir": "s2c", "channel": 0, "fields": [
      {"name": "max_characters", "type": "u8"},
      {"name": "characters", "type": "array", "of": "CharSummary", "max": 16}
    ]},
    {"id": 22, "name": "CreateOptions", "dir": "s2c", "channel": 0, "fields": [
      {"name": "races", "type": "array", "of": "RaceOption", "max": 32},
      {"name": "classes", "type": "array", "of": "OptionEntry", "max": 32},
      {"name": "cities", "type": "array", "of": "OptionEntry", "max": 16}
    ]},
    {"id": 23, "name": "CharCreate", "dir": "c2s", "channel": 0, "fields": [
      {"name": "name", "type": "string", "max": 32},
      {"name": "race", "type": "string", "max": 32},
      {"name": "class_id", "type": "string", "max": 32},
      {"name": "city", "type": "string", "max": 32},
      {"name": "gender", "type": "u8", "_comment": "0 = female, 1 = male"}
    ]},
    {"id": 24, "name": "CharCreateResult", "dir": "s2c", "channel": 0, "fields": [
      {"name": "ok", "type": "bool"},
      {"name": "message", "type": "string", "max": 256},
      {"name": "character", "type": "CharSummary"}
    ]},
    {"id": 25, "name": "CharDelete", "dir": "c2s", "channel": 0, "fields": [
      {"name": "char_id", "type": "u64"}
    ]},
    {"id": 26, "name": "CharDeleteResult", "dir": "s2c", "channel": 0, "fields": [
      {"name": "ok", "type": "bool"},
      {"name": "char_id", "type": "u64"},
      {"name": "message", "type": "string", "max": 256}
    ]},
    {"id": 27, "name": "EnterWorld", "dir": "c2s", "channel": 0, "fields": [
      {"name": "char_id", "type": "u64"}
    ]},
    {"id": 28, "name": "EnterWorldResult", "dir": "s2c", "channel": 0, "fields": [
      {"name": "ok", "type": "bool"},
      {"name": "message", "type": "string", "max": 256},
      {"name": "entity_id", "type": "u32"},
      {"name": "zone_id", "type": "string", "max": 32},
      {"name": "zone_name", "type": "string", "max": 64},
      {"name": "min_x", "type": "f32"},
      {"name": "min_z", "type": "f32"},
      {"name": "max_x", "type": "f32"},
      {"name": "max_z", "type": "f32"},
      {"name": "x", "type": "f32"},
      {"name": "y", "type": "f32"},
      {"name": "z", "type": "f32"},
      {"name": "yaw", "type": "f32"},
      {"name": "run_speed", "type": "f32"},
      {"name": "tick_rate", "type": "u8"},
      {"name": "server_tick", "type": "u32"}
    ]},
    {"id": 29, "name": "Logout", "dir": "c2s", "channel": 0, "fields": []},
    {"id": 30, "name": "LogoutResult", "dir": "s2c", "channel": 0, "fields": [
      {"name": "ok", "type": "bool"}
    ]},

    {"id": 40, "name": "EntitySpawn", "dir": "s2c", "channel": 0, "fields": [
      {"name": "entity_id", "type": "u32"},
      {"name": "kind", "type": "u8"},
      {"name": "name", "type": "string", "max": 64},
      {"name": "race", "type": "string", "max": 32},
      {"name": "class_id", "type": "string", "max": 32},
      {"name": "level", "type": "u8"},
      {"name": "x", "type": "f32"},
      {"name": "y", "type": "f32"},
      {"name": "z", "type": "f32"},
      {"name": "yaw", "type": "f32"},
      {"name": "hp_pct", "type": "u8"},
      {"name": "flags", "type": "u8"},
      {"name": "scale", "type": "f32"},
      {"name": "gender", "type": "u8", "_comment": "players and player corpses: 0 = female, 1 = male"}
    ]},
    {"id": 41, "name": "EntityDespawn", "dir": "s2c", "channel": 0, "fields": [
      {"name": "entity_id", "type": "u32"}
    ]},
    {"id": 42, "name": "MoveInput", "dir": "c2s", "channel": 1, "fields": [
      {"name": "seq", "type": "u32"},
      {"name": "move_x", "type": "f32"},
      {"name": "move_z", "type": "f32"},
      {"name": "yaw", "type": "f32"},
      {"name": "pred_x", "type": "f32"},
      {"name": "pred_y", "type": "f32"},
      {"name": "pred_z", "type": "f32"}
    ]},
    {"id": 43, "name": "Snapshot", "dir": "s2c", "channel": 1, "fields": [
      {"name": "server_tick", "type": "u32"},
      {"name": "ack_seq", "type": "u32"},
      {"name": "self_x", "type": "f32"},
      {"name": "self_y", "type": "f32"},
      {"name": "self_z", "type": "f32"},
      {"name": "entities", "type": "array", "of": "EntityState", "max": 256}
    ]},
    {"id": 44, "name": "MoveCorrection", "dir": "s2c", "channel": 0, "fields": [
      {"name": "ack_seq", "type": "u32"},
      {"name": "x", "type": "f32"},
      {"name": "y", "type": "f32"},
      {"name": "z", "type": "f32"},
      {"name": "reason", "type": "string", "max": 64}
    ]},

    {"id": 50, "name": "ChatSay", "dir": "c2s", "channel": 0, "fields": [
      {"name": "text", "type": "string", "max": 256}
    ]},
    {"id": 51, "name": "ChatMessage", "dir": "s2c", "channel": 0, "fields": [
      {"name": "channel", "type": "u8"},
      {"name": "from_name", "type": "string", "max": 32},
      {"name": "text", "type": "string", "max": 256}
    ]},

    {"id": 60, "name": "SetTarget", "dir": "c2s", "channel": 0, "fields": [
      {"name": "entity_id", "type": "u32"}
    ]},
    {"id": 61, "name": "AutoAttack", "dir": "c2s", "channel": 0, "fields": [
      {"name": "enabled", "type": "bool"}
    ]},
    {"id": 62, "name": "UseAbility", "dir": "c2s", "channel": 0, "fields": [
      {"name": "ability_id", "type": "string", "max": 32},
      {"name": "target_id", "type": "u32"}
    ]},
    {"id": 63, "name": "RespawnRequest", "dir": "c2s", "channel": 0, "fields": []},
    {"id": 64, "name": "LootOpen", "dir": "c2s", "channel": 0, "fields": [
      {"name": "corpse_id", "type": "u32"}
    ]},
    {"id": 65, "name": "LootTake", "dir": "c2s", "channel": 0, "fields": [
      {"name": "corpse_id", "type": "u32"},
      {"name": "slot", "type": "u8"}
    ]},
    {"id": 66, "name": "LootClose", "dir": "c2s", "channel": 0, "fields": [
      {"name": "corpse_id", "type": "u32"}
    ]},
    {"id": 67, "name": "SetSitting", "dir": "c2s", "channel": 0, "fields": [
      {"name": "sitting", "type": "bool"}
    ]},

    {"id": 70, "name": "TargetInfo", "dir": "s2c", "channel": 0, "fields": [
      {"name": "entity_id", "type": "u32"},
      {"name": "con", "type": "u8"},
      {"name": "level", "type": "u8"},
      {"name": "hp_pct", "type": "u8"},
      {"name": "name", "type": "string", "max": 64}
    ]},
    {"id": 71, "name": "CombatEvent", "dir": "s2c", "channel": 0, "fields": [
      {"name": "source_id", "type": "u32"},
      {"name": "target_id", "type": "u32"},
      {"name": "kind", "type": "u8"},
      {"name": "amount", "type": "u32"},
      {"name": "ability", "type": "string", "max": 48},
      {"name": "school", "type": "u8"}
    ]},
    {"id": 72, "name": "PlayerStats", "dir": "s2c", "channel": 1, "fields": [
      {"name": "level", "type": "u8"},
      {"name": "xp", "type": "u32"},
      {"name": "xp_next", "type": "u32"},
      {"name": "hp", "type": "i32"},
      {"name": "max_hp", "type": "i32"},
      {"name": "mana", "type": "i32"},
      {"name": "max_mana", "type": "i32"},
      {"name": "endurance", "type": "i32"},
      {"name": "max_endurance", "type": "i32"},
      {"name": "ac", "type": "u16"},
      {"name": "flags", "type": "u8"},
      {"name": "auto_attack", "type": "bool"},
      {"name": "target_id", "type": "u32"},
      {"name": "run_speed", "type": "f32"}
    ]},
    {"id": 73, "name": "AbilityList", "dir": "s2c", "channel": 0, "fields": [
      {"name": "abilities", "type": "array", "of": "AbilityInfo", "max": 64}
    ]},
    {"id": 74, "name": "AbilityResult", "dir": "s2c", "channel": 0, "fields": [
      {"name": "ok", "type": "bool"},
      {"name": "ability_id", "type": "string", "max": 32},
      {"name": "message", "type": "string", "max": 128},
      {"name": "cooldown_ms", "type": "u32"},
      {"name": "gcd_ms", "type": "u32"}
    ]},
    {"id": 75, "name": "PlayerDied", "dir": "s2c", "channel": 0, "fields": [
      {"name": "killer", "type": "string", "max": 64},
      {"name": "xp_lost", "type": "u32"},
      {"name": "corpse_id", "type": "u32"}
    ]},
    {"id": 76, "name": "LootWindow", "dir": "s2c", "channel": 0, "fields": [
      {"name": "corpse_id", "type": "u32"},
      {"name": "name", "type": "string", "max": 64},
      {"name": "coin", "type": "u64"},
      {"name": "items", "type": "array", "of": "ItemStack", "max": 32}
    ]},
    {"id": 77, "name": "LootClosed", "dir": "s2c", "channel": 0, "fields": [
      {"name": "corpse_id", "type": "u32"},
      {"name": "message", "type": "string", "max": 128}
    ]},
    {"id": 78, "name": "Inventory", "dir": "s2c", "channel": 0, "fields": [
      {"name": "coin", "type": "u64"},
      {"name": "slots", "type": "u8"},
      {"name": "items", "type": "array", "of": "ItemStack", "max": 64}
    ]},
    {"id": 79, "name": "SkillValues", "dir": "s2c", "channel": 0, "fields": [
      {"name": "announce", "type": "bool"},
      {"name": "skills", "type": "array", "of": "SkillValue", "max": 64}
    ]},

    {"id": 80, "name": "CastSpell", "dir": "c2s", "channel": 0, "fields": [
      {"name": "gem", "type": "u8"},
      {"name": "target_id", "type": "u32"}
    ]},
    {"id": 81, "name": "StopCast", "dir": "c2s", "channel": 0, "fields": []},
    {"id": 82, "name": "MemorizeSpell", "dir": "c2s", "channel": 0, "fields": [
      {"name": "gem", "type": "u8"},
      {"name": "spell_id", "type": "string", "max": 32}
    ]},
    {"id": 83, "name": "ScribeSpell", "dir": "c2s", "channel": 0, "fields": [
      {"name": "slot", "type": "u8"}
    ]},
    {"id": 84, "name": "TrainerOpen", "dir": "c2s", "channel": 0, "fields": [
      {"name": "npc_id", "type": "u32"}
    ]},
    {"id": 85, "name": "TrainerBuy", "dir": "c2s", "channel": 0, "fields": [
      {"name": "npc_id", "type": "u32"},
      {"name": "item_id", "type": "string", "max": 32}
    ]},
    {"id": 86, "name": "RezResponse", "dir": "c2s", "channel": 0, "fields": [
      {"name": "offer_id", "type": "u32"},
      {"name": "accept", "type": "bool"}
    ]},

    {"id": 90, "name": "SpellBook", "dir": "s2c", "channel": 0, "fields": [
      {"name": "capacity", "type": "u16"},
      {"name": "spells", "type": "array", "of": "SpellInfo", "max": 128}
    ]},
    {"id": 91, "name": "GemBar", "dir": "s2c", "channel": 0, "fields": [
      {"name": "unlocked", "type": "u8"},
      {"name": "gems", "type": "array", "of": "GemSlot", "max": 8}
    ]},
    {"id": 92, "name": "CastStart", "dir": "s2c", "channel": 0, "fields": [
      {"name": "caster_id", "type": "u32"},
      {"name": "target_id", "type": "u32"},
      {"name": "spell_id", "type": "string", "max": 32},
      {"name": "spell_name", "type": "string", "max": 48},
      {"name": "cast_ms", "type": "u32"},
      {"name": "school", "type": "u8"}
    ]},
    {"id": 93, "name": "CastEnd", "dir": "s2c", "channel": 0, "fields": [
      {"name": "caster_id", "type": "u32"},
      {"name": "spell_id", "type": "string", "max": 32},
      {"name": "result", "type": "u8"},
      {"name": "message", "type": "string", "max": 128}
    ]},
    {"id": 94, "name": "BuffList", "dir": "s2c", "channel": 0, "fields": [
      {"name": "entity_id", "type": "u32"},
      {"name": "buffs", "type": "array", "of": "BuffInfo", "max": 48}
    ]},
    {"id": 95, "name": "TrainerWindow", "dir": "s2c", "channel": 0, "fields": [
      {"name": "npc_id", "type": "u32"},
      {"name": "name", "type": "string", "max": 64},
      {"name": "greeting", "type": "string", "max": 256},
      {"name": "entries", "type": "array", "of": "TrainerEntry", "max": 128}
    ]},
    {"id": 96, "name": "RezOffer", "dir": "s2c", "channel": 0, "fields": [
      {"name": "offer_id", "type": "u32"},
      {"name": "caster", "type": "string", "max": 32},
      {"name": "pct", "type": "u8"},
      {"name": "corpse_id", "type": "u32"},
      {"name": "expires_ms", "type": "u32"}
    ]}
  ]
}
