{
  "_comment": "Realms of Emberfall wire protocol. Edit this file, then run `python tools/gen_protocol.py` to regenerate C++ and GDScript. Bump `version` on any breaking change.",
  "version": 15,
  "encoding": "Little-endian. Packet = u16 message id + fields in order. string = u16 byte length + UTF-8 (max enforced). array = u16 count + elements (max enforced). f32 must be finite. Trailing bytes are rejected.",
  "channels": {
    "0": "reliable ordered: handshake, auth, characters, spawns, chat, combat events, loot, items, trade, auctions",
    "1": "unreliable sequenced: movement input, snapshots, player stats",
    "2": "TLS login stream (TCP, never ENet): u16 length prefix + packet; carries the password and the session key",
    "sealed": "Phase 10: from TicketLogin on, every ENet packet on channels 0 and 1, both ways, is sealed with the session key from TlsLoginResult: u64 LE counter + AES-256-CTR ciphertext + the first 16 bytes of HMAC-SHA256 (server/src/net/packet_crypto.hpp). Only Hello, HelloResult, ServerStatus, Kick, TicketLogin and a refused AuthResult travel unsealed."
  },
  "structs": {
    "CharSummary": [
      {"name": "id", "type": "u64"},
      {"name": "name", "type": "string", "max": 15},
      {"name": "race", "type": "string", "max": 32},
      {"name": "class_id", "type": "string", "max": 32},
      {"name": "city", "type": "string", "max": 32},
      {"name": "level", "type": "u8"},
      {"name": "zone", "type": "string", "max": 32},
      {"name": "gender", "type": "u8", "_comment": "0 = female, 1 = male"}
    ],
    "OptionEntry": [
      {"name": "id", "type": "string", "max": 32},
      {"name": "name", "type": "string", "max": 48},
      {"name": "description", "type": "string", "max": 256}
    ],
    "RaceOption": [
      {"name": "id", "type": "string", "max": 32},
      {"name": "name", "type": "string", "max": 48},
      {"name": "description", "type": "string", "max": 256},
      {"name": "classes", "type": "array", "of": "string", "max": 32, "max_len": 32},
      {"name": "cities", "type": "array", "of": "string", "max": 8, "max_len": 32}
    ],
    "EntityState": [
      {"name": "entity_id", "type": "u32"},
      {"name": "x", "type": "f32"},
      {"name": "y", "type": "f32"},
      {"name": "z", "type": "f32"},
      {"name": "yaw", "type": "f32"},
      {"name": "hp_pct", "type": "u8"},
      {"name": "flags", "type": "u8"},
      {"name": "flags2", "type": "u8", "_comment": "1 feigned, 2 hidden/invisible, 4 sneaking, 8 singing, 16 pet, 32 charmed"}
    ],
    "AbilityInfo": [
      {"name": "id", "type": "string", "max": 32},
      {"name": "name", "type": "string", "max": 48},
      {"name": "type", "type": "string", "max": 16},
      {"name": "level", "type": "u8"},
      {"name": "resource", "type": "u8"},
      {"name": "cost", "type": "u16"},
      {"name": "cooldown_ms", "type": "u32"},
      {"name": "range", "type": "f32"},
      {"name": "target", "type": "u8"},
      {"name": "gcd", "type": "bool"},
      {"name": "description", "type": "string", "max": 256}
    ],
    "ItemStack": [
      {"name": "slot", "type": "u16", "_comment": "slot code: (container << 8) | index. Containers: 0 worn, 1 pack, 2 bank, 0x10+g bag in pack slot g, 0x20+b bag in bank slot b"},
      {"name": "item_id", "type": "string", "max": 32},
      {"name": "count", "type": "u16"},
      {"name": "expires_ms", "type": "u32", "_comment": "summoned items: time until they vanish (0 = never)"}
    ],
    "SkillValue": [
