  "messages": [
    {"id": 1, "name": "Hello", "dir": "c2s", "channel": 0, "fields": [
      {"name": "protocol_version", "type": "u16"},
      {"name": "client_build", "type": "string", "max": 64}
    ]},
    {"id": 2, "name": "HelloResult", "dir": "s2c", "channel": 0, "fields": [
      {"name": "ok", "type": "bool"},
      {"name": "server_protocol_version", "type": "u16"},
      {"name": "message", "type": "string", "max": 256},
      {"name": "login_port", "type": "u16"},
      {"name": "cert_pem", "type": "string", "max": 3000},
      {"name": "session_nonce", "type": "string", "max": 64}
    ]},
    {"id": 3, "name": "Kick", "dir": "s2c", "channel": 0, "fields": [
      {"name": "reason", "type": "string", "max": 256}
    ]},
    {"id": 4, "name": "ServerStatus", "dir": "s2c", "channel": 0, "_comment": "Phase 8: sent right after HelloResult (a separate message, so HelloResult stays readable by older clients). Shown on the login screen.", "fields": [
      {"name": "motd", "type": "string", "max": 1000},
      {"name": "players_online", "type": "u16"},
      {"name": "max_players", "type": "u16"},
      {"name": "server_version", "type": "string", "max": 32}
    ]},
    {"id": 10, "name": "TlsLogin", "dir": "c2s", "channel": 2, "fields": [
      {"name": "username", "type": "string", "max": 32},
      {"name": "password", "type": "string", "max": 128},
      {"name": "is_register", "type": "bool"},
      {"name": "session_nonce", "type": "string", "max": 64}
    ]},
    {"id": 11, "name": "TlsLoginResult", "dir": "s2c", "channel": 2, "fields": [
      {"name": "ok", "type": "bool"},
      {"name": "message", "type": "string", "max": 256},
      {"name": "ticket", "type": "string", "max": 64},
      {"name": "session_key", "type": "string", "max": 64, "_comment": "Phase 10: 64 hex digits; seals every ENet packet from the ticket login on (server/src/net/packet_crypto.hpp)"}
    ]},
    {"id": 13, "name": "TicketLogin", "dir": "c2s", "channel": 0, "fields": [
      {"name": "ticket", "type": "string", "max": 64}
    ]},
    {"id": 12, "name": "AuthResult", "dir": "s2c", "channel": 0, "fields": [
      {"name": "ok", "type": "bool"},
      {"name": "message", "type": "string", "max": 256}
    ]},
    {"id": 20, "name": "CharListRequest", "dir": "c2s", "channel": 0, "fields": []},
    {"id": 21, "name": "CharList", "dir": "s2c", "channel": 0, "fields": [
      {"name": "max_characters", "type": "u8"},
      {"name": "characters", "type": "array", "of": "CharSummary", "max": 16}
    ]},
    {"id": 22, "name": "CreateOptions", "dir": "s2c", "channel": 0, "fields": [
      {"name": "races", "type": "array", "of": "RaceOption", "max": 32},
      {"name": "classes", "type": "array", "of": "OptionEntry", "max": 32},
      {"name": "cities", "type": "array", "of": "OptionEntry", "max": 16}
    ]},
    {"id": 23, "name": "CharCreate", "dir": "c2s", "channel": 0, "fields": [
      {"name": "name", "type": "string", "max": 32},
      {"name": "race", "type": "string", "max": 32},
      {"name": "class_id", "type": "string", "max": 32},
      {"name": "city", "type": "string", "max": 32},
      {"name": "gender", "type": "u8", "_comment": "0 = female, 1 = male"}
    ]},
    {"id": 24, "name": "CharCreateResult", "dir": "s2c", "channel": 0, "fields": [
      {"name": "ok", "type": "bool"},
      {"name": "message", "type": "string", "max": 256},
      {"name": "character", "type": "CharSummary"}
    ]},
    {"id": 25, "name": "CharDelete", "dir": "c2s", "channel": 0, "fields": [
      {"name": "char_id", "type": "u64"}
    ]},
    {"id": 26, "name": "CharDeleteResult", "dir": "s2c", "channel": 0, "fields": [
