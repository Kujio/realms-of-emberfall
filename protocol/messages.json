      {"name": "name", "type": "string", "max": 64},
      {"name": "level", "type": "u8"},
      {"name": "zone", "type": "string", "max": 32},
      {"name": "step", "type": "u8", "_comment": "current step (0-based); == steps when ready to turn in"},
      {"name": "steps", "type": "u8"},
      {"name": "text", "type": "string", "max": 128, "_comment": "the current step's journal line (or where to turn it in)"},
