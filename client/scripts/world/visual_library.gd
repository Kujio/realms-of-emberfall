## Read-only access to the client's bundled display content (res://data/visuals.json, generated by
## tools/sync_client_content.py from content/models.json, appearance.json and items.json).
## Resolves what an entity looks like: a model, its animation map, material tints, part choices,
## scale and held items. Scenes load lazily and are cached; anything missing degrades to the
## model's placeholder shape instead of failing.
extends RefCounted

const DATA_PATH: String = "res://data/visuals.json"
const GENDERS: Array[String] = ["female", "male"]
const FALLBACK_MODEL: Dictionary = {
	"id": "_fallback", "scene": "", "scale": 1.0, "nameplate_height": 2.2, "collision_radius": 0.5,
	"placeholder": {"shape": "upright", "color": "#998080"},
}

static var _data: Dictionary = {}
static var _loaded: bool = false
static var _scenes: Dictionary = {}  # res path -> PackedScene (or null when it failed to load)
static var _warned: Dictionary = {}


static func data() -> Dictionary:
	if not _loaded:
		_loaded = true
		var text: String = FileAccess.get_file_as_string(DATA_PATH)
		var parsed: Variant = JSON.parse_string(text) if text != "" else null
		if parsed is Dictionary:
			_data = parsed
		else:
			push_warning("visuals: cannot read %s; every entity uses a placeholder" % DATA_PATH)
			_data = {}
	return _data


## Test hook: replace the data (null restores the bundled file on next use).
static func override_data(d: Variant) -> void:
	if d == null:
		_loaded = false
		_data = {}
	else:
		_loaded = true
		_data = d
	_scenes.clear()


static func _section(name: String) -> Dictionary:
	var v: Variant = data().get(name, {})
	return v if v is Dictionary else {}


static func model(model_id: String) -> Dictionary:
	var m: Variant = _section("models").get(model_id)
	if m is Dictionary:
		return m
	_warn_once("model:" + model_id, "visuals: unknown model '%s', using a placeholder" % model_id)
	var f: Dictionary = FALLBACK_MODEL.duplicate(true)
	f["id"] = model_id
	return f


static func anim_map(map_id: String) -> Dictionary:
	var m: Variant = _section("animation_maps").get(map_id)
	return m if m is Dictionary else {}


static func item_visual(item_id: String) -> Dictionary:
	var vid: Variant = _section("item_visual_of").get(item_id)
	if vid == null:
		return {}
	var v: Variant = _section("item_visuals").get(str(vid))
	return v if v is Dictionary else {}


static func visual_by_id(visual_id: String) -> Dictionary:
	var v: Variant = _section("item_visuals").get(visual_id)
	return v if v is Dictionary else {}


static func gender_name(gender: int) -> String:
	return GENDERS[clampi(gender, 0, GENDERS.size() - 1)]


## A resolved look: {model: Dictionary, scale: Vector3, tints: {material: Color}, parts: {group: node},
## held: {slot: item visual Dictionary}, outfit_tint?: Color}. Layers: model defaults, then race+gender
## (and its outfit for the armour type worn), then class.
## `equipment` ({main_hand, off_hand, ranged, chest, head} item ids) replaces the class's default held items
## with what the character actually wears, picks the outfit from the chest piece and shows a helmet while a
## head item is worn; null keeps the class defaults (character select previews).
static func player_look(race_id: String, gender: int, class_id: String, equipment: Variant = null) -> Dictionary:
	var race: Dictionary = _section("races").get(race_id, {}) as Dictionary
	var g: Dictionary = race.get(gender_name(gender), {}) as Dictionary
	var outfit: Dictionary = outfit_for(class_id, equipment)
	var outfits: Variant = g.get("outfits", {})
	if outfits is Dictionary and (outfits as Dictionary).get(str(outfit["armor"])) is Dictionary:
		g = g.duplicate()
		g.merge((outfits as Dictionary)[str(outfit["armor"])] as Dictionary, true)
	var model_id: String = str(g.get("model", "humanoid"))
	var look: Dictionary = mob_look(model_id)
	look["scale"] = _scale_of(g.get("scale", 1.0))
	_merge_tints(look, g.get("tints", {}))
	_merge_parts(look, g.get("parts", {}))
	var cls: Dictionary = _section("classes").get(class_id, {}) as Dictionary
	# Models dressed by their own outfit ("class_style": false) skip the class's tints and parts.
	if bool((look.get("model", {}) as Dictionary).get("class_style", true)):
		_merge_tints(look, cls.get("tints", {}))
		_merge_parts(look, cls.get("parts", {}))
	var held: Dictionary = {}
	if equipment is Dictionary:
		held = equipment_held(equipment as Dictionary)
	else:
		var held_items: Variant = cls.get("held", {})
		if held_items is Dictionary:
			for slot: String in (held_items as Dictionary).keys():
				var v: Dictionary = item_visual(str(held_items[slot]))
				if not v.is_empty():
					held[slot] = v
	look["held"] = held
	var tint: String = str(outfit.get("tint", ""))
	if tint.is_valid_html_color() and Color.html(tint) != Color.WHITE:
		look["outfit_tint"] = Color.html(tint)
	var helm: Variant = ((look["model"] as Dictionary).get("parts", {}) as Dictionary).get("helm")
	if helm is Array and not (helm as Array).is_empty():
		var worn: bool = equipment is Dictionary and str((equipment as Dictionary).get("head", "")) != ""
		(look["parts"] as Dictionary)["helm"] = str((helm as Array)[0]) if worn else ""
	return look


## The outfit a character wears: {armor, tint}. The chest piece's armour type and tier tint, or with none
## (or no equipment known), the class's own armour type untinted.
static func outfit_for(class_id: String, equipment: Variant) -> Dictionary:
	if equipment is Dictionary:
		var o: Variant = _section("outfit_of").get(str((equipment as Dictionary).get("chest", "")))
		if o is Dictionary:
			return {"armor": str((o as Dictionary).get("armor", "")), "tint": str((o as Dictionary).get("tint", ""))}
	return {"armor": str(_section("class_armor").get(class_id, "")), "tint": ""}


## How an outfit tint applies: to mesh nodes starting with "prefix", except those in "keep".
static func outfit_tint_rule() -> Dictionary:
	return _section("outfit_tint")


## Worn weapons as held visuals: the primary in the main hand, the secondary in the off hand (whatever
## hand its mesh was authored for), a bow slung on the back. Items without a mesh are simply not drawn.
static func equipment_held(equipment: Dictionary) -> Dictionary:
	var held: Dictionary = {}
	var main: Dictionary = item_visual(str(equipment.get("main_hand", "")))
	if not main.is_empty():
		var m: Dictionary = main.duplicate()
		m["slot"] = "main_hand"
		if str(main.get("slot", "")) != "main_hand":
			m["attach_point"] = "main_hand"
		held["main_hand"] = m
	var off: Dictionary = item_visual(str(equipment.get("off_hand", "")))
	if not off.is_empty():
		var o: Dictionary = off.duplicate()
		o["slot"] = "off_hand"
		if str(off.get("slot", "")) != "off_hand":
			o["attach_point"] = "off_hand"
		held["off_hand"] = o
	var ranged: Dictionary = item_visual(str(equipment.get("ranged", "")))
	if not ranged.is_empty() and not held.has("back"):
		var r: Dictionary = ranged.duplicate()
		r["slot"] = "back"
		if str(ranged.get("slot", "")) != "back":
			r["attach_point"] = "back"
		held["back"] = r
	return held


## The look of a model by id (mobs, NPCs, mob corpses): the model's own defaults.
static func mob_look(model_id: String) -> Dictionary:
	var m: Dictionary = model(model_id)
	var look: Dictionary = {"model": m, "scale": Vector3.ONE, "tints": {}, "parts": {}, "held": {}}
	_merge_tints(look, m.get("tints", {}))
	_merge_parts(look, m.get("default_parts", {}))
	return look


static func _scale_of(v: Variant) -> Vector3:
	if v is Array and (v as Array).size() == 3:
		var a: Array = v
		return Vector3(clampf(float(a[0]), 0.3, 3.0), clampf(float(a[1]), 0.3, 3.0), clampf(float(a[2]), 0.3, 3.0))
	if v is float or v is int:
		var s: float = clampf(float(v), 0.3, 3.0)
		return Vector3(s, s, s)
	return Vector3.ONE


static func _merge_tints(look: Dictionary, tints: Variant) -> void:
	if not tints is Dictionary:
		return
	var out: Dictionary = look["tints"]
	for k: String in (tints as Dictionary).keys():
		var c: String = str(tints[k])
		if c.is_valid_html_color():
			out[k] = Color.html(c)


static func _merge_parts(look: Dictionary, parts: Variant) -> void:
	if not parts is Dictionary:
		return
	var out: Dictionary = look["parts"]
	for k: String in (parts as Dictionary).keys():
		out[k] = str(parts[k])


## A cached PackedScene for a res:// path, or null (missing or broken files warn once).
static func load_scene(path: String) -> PackedScene:
	if path == "":
		return null
	if _scenes.has(path):
		return _scenes[path] as PackedScene
	var ps: PackedScene = null
	if ResourceLoader.exists(path):
		ps = ResourceLoader.load(path) as PackedScene
	if ps == null:
		_warn_once("scene:" + path, "visuals: cannot load %s, using a placeholder" % path)
	_scenes[path] = ps
	return ps


static func _warn_once(key: String, text: String) -> void:
	if not _warned.has(key):
		_warned[key] = true
		push_warning(text)
