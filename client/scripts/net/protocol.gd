	if not r.ok:
		return {}
	var m: Dictionary = {}
	match id:
		1:
			m = _dec_msg_1(r)
		2:
			m = _dec_msg_2(r)
		3:
			m = _dec_msg_3(r)
		4:
			m = _dec_msg_4(r)
		10:
			m = _dec_msg_10(r)
		11:
			m = _dec_msg_11(r)
		13:
