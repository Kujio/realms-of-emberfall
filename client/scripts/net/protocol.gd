## Decodes a packet. Returns {} on any malformed input; otherwise the message
## fields plus "_id" (int) and "_name" (String).
static func decode(data: PackedByteArray) -> Dictionary:
	var r: Reader = Reader.new(data)
	var id: int = r.u16()
	if not r.ok:
		return {}
	var m: Dictionary = {}
	match id:
		1:
			m = _dec_msg_1(r)
		2:
			m = _dec_msg_2(r)
